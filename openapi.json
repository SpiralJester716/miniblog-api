  "components": {
    "schemas": {
      "AuthorInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "bio": {
            "type": "string",
            "default": ""
          }
        }
      },
      "PostInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "author_id",
          "title",
          "content"
        ],
        "properties": {
          "author_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "published": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "CommentInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "post_id",
          "author_id",
          "content"
        ],
        "properties": {
          "post_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "author_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Author": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "bio",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "bio": {
            "type": "string",
            "default": ""
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Post": {
        "type": "object",
        "required": [
          "id",
          "author_id",
          "title",
          "content",
          "published",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "author_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "published": {
            "type": "boolean",
            "default": false
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Comment": {
        "type": "object",
        "required": [
          "id",
          "post_id",
          "author_id",
          "content",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "post_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "author_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PostWithAuthor": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Post"
          },
          {
            "type": "object",
            "required": [
              "author"
            ],
            "properties": {
              "author": {
                "$ref": "#/components/schemas/Author"
              }
            }
          }
        ]
      }
    }
  }
